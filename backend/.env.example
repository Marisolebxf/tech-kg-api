# App
APP_ENV=dev
SERVER_PORT=8000

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=gkx_element
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456789
PAPER_COOP_MYSQL_DATABASE=gkx_element

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# 统一用户中心 OAuth2（本地无客户端凭证时可关闭鉴权）
AUTH_ENABLED=false
AUTH_SESSION_BACKEND=memory
AUTH_SESSION_COOKIE=techkg_session
AUTH_SESSION_TTL_SECONDS=604800
AUTH_STATE_TTL_SECONDS=300
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_PATH=/
AUTH_FRONTEND_URL=http://127.0.0.1:5173
USER_CENTER_SSO_LOGIN_URL=https://edu.itic-sci.com/uc/sso/login
USER_CENTER_OAUTH_BASE_URL=https://edu.itic-sci.com/uc/admin-api/system/oauth2
USER_CENTER_CLIENT_ID=
USER_CENTER_CLIENT_SECRET=
USER_CENTER_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/callback
USER_CENTER_SCOPE=user_info

# TRSGraph (HTTP REST via trs-graph-service, fronts NebulaGraph)
TRS_GRAPH_BASE_URL=http://localhost:8090
TRS_GRAPH_SPACE=dev
TRS_GRAPH_API_KEY=ysukeg
TRS_GRAPH_TIMEOUT=30

# Kafka
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_CONSUMER_GROUP=techkg

# Milvus
MILVUS_HOST=milvus
MILVUS_PORT=19530
PATENT_EMBEDDING_PROVIDER=local
PATENT_LOCAL_EMBEDDING_MODEL=moka-ai/m3e-small
PATENT_EMBEDDING_DIM=512
PATENT_EMBEDDING_DEVICE=cpu
PATENT_EMBEDDING_BATCH_SIZE=8
# 在线服务模式由根目录docker-compose.yml覆盖为以下配置：
# PATENT_EMBEDDING_PROVIDER=openai
# PATENT_EMBEDDING_BASE_URL=http://m3e-embedding:8010/v1
# PATENT_EMBEDDING_MODEL=moka-ai/m3e-small
# PATENT_EMBEDDING_DIM=512
# PATENT_EMBEDDING_API_KEY=local-no-auth

# LLM
ZHIPUAI_API_KEY=
MODEL=glm-5.2
LLM_API_KEY=${ZHIPUAI_API_KEY}
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=${MODEL}
