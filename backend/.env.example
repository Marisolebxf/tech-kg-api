# App
APP_ENV=dev
SERVER_PORT=8000

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=gkx_element
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456789
PAPER_COOP_MYSQL_DATABASE=gkx_element

# TRSGraph (HTTP REST via trs-graph-service, fronts NebulaGraph)
TRS_GRAPH_BASE_URL=http://localhost:8090
TRS_GRAPH_SPACE=dev
TRS_GRAPH_API_KEY=ysukeg
TRS_GRAPH_TIMEOUT=30

# Milvus
MILVUS_HOST=milvus
MILVUS_PORT=19530
PATENT_EMBEDDING_PROVIDER=local
PATENT_LOCAL_EMBEDDING_MODEL=moka-ai/m3e-small
PATENT_EMBEDDING_DIM=512
PATENT_EMBEDDING_DEVICE=cpu
PATENT_EMBEDDING_BATCH_SIZE=8
# 在线服务模式由根目录docker-compose.yml覆盖为以下配置：
# PATENT_EMBEDDING_PROVIDER=openai
# PATENT_EMBEDDING_BASE_URL=http://m3e-embedding:8010/v1
# PATENT_EMBEDDING_MODEL=moka-ai/m3e-small
# PATENT_EMBEDDING_DIM=512
# PATENT_EMBEDDING_API_KEY=local-no-auth

# LLM
ZHIPUAI_API_KEY=
MODEL=glm-5.2
LLM_API_KEY=${ZHIPUAI_API_KEY}
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=${MODEL}
# Temporal 与工作流控制面
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=tech-kg-workflows
WORKFLOW_DATABASE_PATH=/tmp/tech-kg-workflows.db
WORKFLOW_SCRIPT_DIR=/tmp/tech-kg-workflow-scripts
WORKFLOW_RETRY_INTERVAL_SECONDS=30

# Schema 脚本对象存储
SCHEMA_AUTO_INIT=false
SCHEMA_S3_ENDPOINT_URL=http://127.0.0.1:9020
SCHEMA_S3_ACCESS_KEY=minioadmin
SCHEMA_S3_SECRET_KEY=minioadmin
SCHEMA_S3_BUCKET=tech-kg-schema-scripts
SCHEMA_S3_REGION=us-east-1
SCHEMA_S3_SECURE=false
SCHEMA_SCRIPT_MAX_BYTES=10485760
SCHEMA_ADMIN_USER_IDS=schema-admin
