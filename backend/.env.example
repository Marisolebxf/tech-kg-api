# App
APP_ENV=dev
SERVER_PORT=8000

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=gkx_element
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456789
PAPER_COOP_MYSQL_DATABASE=gkx_element

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# 统一用户中心 OAuth2（客户端密钥只写入复制后的 .env 或部署密钥，禁止提交 Git）
AUTH_ENABLED=false
AUTH_SESSION_BACKEND=memory
AUTH_SESSION_COOKIE=techkg_session
USER_CENTER_PORTAL_COOKIE_LOGIN_ENABLED=false
USER_CENTER_PORTAL_TOKEN_COOKIE=access_token
AUTH_SESSION_TTL_SECONDS=604800
AUTH_STATE_TTL_SECONDS=300
AUTH_AUDIT_TTL_SECONDS=7776000
AUTH_AUDIT_MAX_ITEMS=200
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_PATH=/
AUTH_FRONTEND_URL=http://127.0.0.1:5173
USER_CENTER_SSO_LOGIN_URL=https://edu.itic-sci.com/uc/sso/login
USER_CENTER_OAUTH_BASE_URL=https://edu.itic-sci.com/uc/admin-api/system/oauth2
USER_CENTER_ACCOUNT_URL=https://edu.itic-sci.com/uc/admin/login?redirect=/index
USER_CENTER_CLIENT_ID=
USER_CENTER_CLIENT_SECRET=
USER_CENTER_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/callback
# 新应用未分配授权范围时留空；用户中心明确分配后再填写
USER_CENTER_SCOPE=
# 逗号分隔的统一用户中心用户 ID；这些账号是首批不可在页面取消的全局管理员
PLATFORM_INITIAL_ADMIN_USER_IDS=
# 管理员表为空且未配置首批管理员时，首次成功登录的用户永久成为首位管理员
PLATFORM_BOOTSTRAP_FIRST_ADMIN=true
# 仅非生产环境生效：后端本次启动后第一个成功登录的账号临时作为管理员
PLATFORM_DEV_FIRST_USER_ADMIN=false

# 人工修正可靠同步
CORRECTION_SYNC_WORKER_ENABLED=true
CORRECTION_SYNC_INTERVAL_SECONDS=30
CORRECTION_SYNC_MAX_ATTEMPTS=8
# projection=仅写人工修正投影，不影响九大功能；dual=同时写入业务图库
CORRECTION_SYNC_MODE=projection

# TRSGraph (HTTP REST via trs-graph-service, fronts NebulaGraph)
TRS_GRAPH_BASE_URL=http://localhost:8090
TRS_GRAPH_SPACE=dev
TRS_GRAPH_API_KEY=ysukeg
TRS_GRAPH_TIMEOUT=30

# Kafka
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_CONSUMER_GROUP=techkg

# Milvus
MILVUS_HOST=milvus
MILVUS_PORT=19530
PATENT_EMBEDDING_PROVIDER=local
PATENT_LOCAL_EMBEDDING_MODEL=moka-ai/m3e-small
PATENT_EMBEDDING_DIM=512
PATENT_EMBEDDING_DEVICE=cpu
PATENT_EMBEDDING_BATCH_SIZE=8
# 在线服务模式由根目录docker-compose.yml覆盖为以下配置：
# PATENT_EMBEDDING_PROVIDER=openai
# PATENT_EMBEDDING_BASE_URL=http://m3e-embedding:8010/v1
# PATENT_EMBEDDING_MODEL=moka-ai/m3e-small
# PATENT_EMBEDDING_DIM=512
# PATENT_EMBEDDING_API_KEY=local-no-auth

# LLM
ZHIPUAI_API_KEY=
MODEL=glm-5.2
LLM_API_KEY=${ZHIPUAI_API_KEY}
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=${MODEL}
# Temporal 与工作流控制面
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=tech-kg-workflows
WORKFLOW_DATABASE_PATH=/tmp/tech-kg-workflows.db
WORKFLOW_SCRIPT_DIR=/tmp/tech-kg-workflow-scripts
WORKFLOW_DEMO_DATA_ENABLED=false

# Temporal/worker 调用内部算子重载端点时使用；生产环境必须设置随机强令牌
OPERATOR_RELOAD_TOKEN=

# Production manual review
REVIEW_PRODUCTION_ENABLED=false
REVIEW_IDENTITY_REQUIRE_SIGNATURE=true
REVIEW_IDENTITY_HMAC_SECRET=replace-with-gateway-shared-secret
REVIEW_ROLLOUT_MODE=shadow
REVIEW_EVIDENCE_MAX_BYTES=20971520
REVIEW_EVIDENCE_CONTENT_TYPES=application/pdf,image/png,image/jpeg,text/plain
REVIEW_S3_ENDPOINT_URL=http://127.0.0.1:9030
REVIEW_S3_ACCESS_KEY=minioadmin
REVIEW_S3_SECRET_KEY=minioadmin
REVIEW_S3_REGION=us-east-1
REVIEW_S3_BUCKET=tech-kg-review-evidence
REVIEW_S3_SECURE=false

# Gateway header names (gateway may normalize these to canonical defaults)
REVIEW_HEADER_USER_ID=X-User-Id
REVIEW_HEADER_USER_NAME=X-User-Name
REVIEW_HEADER_ROLES=X-User-Roles
REVIEW_HEADER_DOMAINS=X-User-Domains
REVIEW_HEADER_ORGANIZATION=X-User-Organization
REVIEW_HEADER_REQUEST_ID=X-Request-Id
REVIEW_HEADER_SIGNATURE=X-Identity-Signature
REVIEW_OUTBOX_POLL_SECONDS=2
REVIEW_OUTBOX_BATCH_SIZE=20
REVIEW_HEARTBEAT_TIMEOUT_MINUTES=5

# Graph-build handoff (mock is development-only; production must use remote)
REVIEW_RERUN_MODE=mock
GRAPH_BUILD_INTERNAL_URL=http://127.0.0.1:8010
GRAPH_BUILD_SERVICE_TOKEN=replace-with-service-token
REVIEW_RESUME_TIMEOUT_SECONDS=10
REVIEW_RESUME_MAX_ATTEMPTS=5
REVIEW_OUTBOX_LOCK_TIMEOUT_SECONDS=60
REVIEW_SERVICE_CLOCK_SKEW_SECONDS=300
REVIEW_SNAPSHOT_MAX_BYTES=2097152
