# 复制为 .env 后填写。不要把真实密码提交到 Git 或发到群聊。

# gkx_element 只读源库。建议为 ETL 创建仅有 SELECT 权限的专用账户。
GKX_ELEMENT_MYSQL_HOST=127.0.0.1
GKX_ELEMENT_MYSQL_PORT=3306
GKX_ELEMENT_MYSQL_DATABASE=gkx_element
GKX_ELEMENT_MYSQL_USERNAME=organization_etl_reader
GKX_ELEMENT_MYSQL_PASSWORD=CHANGE_ME

# trs-graph-service HTTP 地址。不是 NebulaGraph GraphD 的 9669 端口。
TRS_GRAPH_BASE_URL=http://127.0.0.1:8090
TRS_GRAPH_SPACE=dev
TRS_GRAPH_API_KEY=
TRS_GRAPH_TIMEOUT=60

# 本地输出与互斥锁。目录不存在时自动创建。
ORGANIZATION_REPORT_DIR=./var/reports/organization
ORGANIZATION_ETL_LOCK_FILE=/tmp/tech_kg_organization_etl.lock

# 仅 --alignment-mode hybrid 时需要 Milvus。
# MILVUS_URI=http://127.0.0.1:19530
# MILVUS_TOKEN=
# MILVUS_DB_NAME=default
# ORG_MILVUS_STATE_DIR=./var/organization_milvus
