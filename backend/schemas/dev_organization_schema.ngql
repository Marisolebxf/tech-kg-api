-- Canonical schema for organization entity and relation ETLs.
-- Both ETLs use this file.  It is idempotent and restricted to the dev space.
USE dev;

CREATE TAG IF NOT EXISTS `Organization`(
  `org_id` string NULL,
  `organization_id` string NULL,
  `confidence` double NULL,
  `name_cn` string NULL,
  `name_en` string NULL,
  `external_id` string NULL,
  `province` string NULL,
  `city` string NULL,
  `area` string NULL,
  `country_code` string NULL,
  `country` string NULL,
  `address` string NULL,
  `postal_code` string NULL,
  `phone` string NULL,
  `email` string NULL,
  `legal_rep` string NULL,
  `org_type` string NULL,
  `org_size` string NULL,
  `founded_year` int64 NULL,
  `listing_status` string NULL,
  `listed_date` string NULL,
  `registered_capital` double NULL,
  `capital_currency` string NULL,
  `industry_class` string NULL,
  `stock_code` string NULL,
  `stock_noun` string NULL,
  `stock_type` string NULL,
  `org_kind` string NULL,
  `description` string NULL,
  `main_products` string NULL,
  `extra_json` string NULL,
  `source_system` string NULL,
  `source_table` string NULL,
  `source_record_id` string NULL,
  `source_url` string NULL,
  `ingest_batch` string NULL,
  `ingest_time` string NULL,
  `source_update_time` string NULL
);

CREATE TAG IF NOT EXISTS `organization_base`(
  `organization_id` string NULL,
  `confidence` double NULL,
  `source_system` string NULL,
  `source_table` string NULL,
  `source_record_id` string NULL,
  `source_url` string NULL,
  `ingest_batch` string NULL,
  `ingest_time` string NULL,
  `source_update_time` string NULL,
  `extra_json` string NULL
);

CREATE TAG IF NOT EXISTS `Person`(
  `name_cn` string NULL,
  `name_en` string NULL,
  `person_kind` string NULL,
  `country_code` string NULL,
  `country` string NULL,
  `birth_date` string NULL,
  `gender` string NULL,
  `biography` string NULL,
  `organization_id` string NULL,
  `confidence` double NULL,
  `extra_json` string NULL,
  `source_system` string NULL,
  `source_table` string NULL,
  `source_record_id` string NULL,
  `source_url` string NULL,
  `ingest_batch` string NULL,
  `ingest_time` string NULL,
  `source_update_time` string NULL
);

CREATE TAG IF NOT EXISTS `News`(
  `title` string NULL,
  `content` string NULL,
  `release_date` string NULL,
  `original_url` string NULL,
  `organization_id` string NULL,
  `confidence` double NULL,
  `extra_json` string NULL,
  `source_system` string NULL,
  `source_table` string NULL,
  `source_record_id` string NULL,
  `source_url` string NULL,
  `ingest_batch` string NULL,
  `ingest_time` string NULL,
  `source_update_time` string NULL
);

CREATE TAG IF NOT EXISTS `Event`(
  `event_type` string NULL,
  `raw_id` string NULL,
  `title` string NULL,
  `content` string NULL,
  `case_no` string NULL,
  `case_cause` string NULL,
  `occur_date` string NULL,
  `amount` double NULL,
  `currency` string NULL,
  `organization_id` string NULL,
  `confidence` double NULL,
  `extra_json` string NULL,
  `source_system` string NULL,
  `source_table` string NULL,
  `source_record_id` string NULL,
  `source_url` string NULL,
  `ingest_batch` string NULL,
  `ingest_time` string NULL,
  `source_update_time` string NULL
);

CREATE TAG IF NOT EXISTS `Project`(
  `project_number` string NULL,
  `title` string NULL,
  `project_source` string NULL,
  `project_level` string NULL,
  `funded_amount` double NULL,
  `discipline` string NULL,
  `discipline_code` string NULL,
  `fund_category` string NULL,
  `funded_region` string NULL,
  `approval_year` string NULL,
  `approval_time` string NULL,
  `research_period` string NULL,
  `abstract` string NULL,
  `final_report_abstract` string NULL,
  `project_page_url` string NULL,
  `extra_json` string NULL,
  `source_system` string NULL,
  `source_table` string NULL,
  `source_record_id` string NULL,
  `source_url` string NULL,
  `ingest_batch` string NULL,
  `ingest_time` string NULL,
  `source_update_time` string NULL
);

CREATE TAG IF NOT EXISTS `Product`(
  `name` string NULL,
  `category` string NULL,
  `description` string NULL,
  `extra_json` string NULL,
  `organization_id` string NULL,
  `confidence` double NULL,
  `source_system` string NULL,
  `source_table` string NULL,
  `source_record_id` string NULL,
  `source_url` string NULL,
  `ingest_batch` string NULL,
  `ingest_time` string NULL,
  `source_update_time` string NULL
);

CREATE TAG IF NOT EXISTS `DataSource`(
  `source_table` string NULL,
  `table_cn_name` string NULL,
  `tier` string NULL,
  `library` string NULL
);

CREATE EDGE IF NOT EXISTS `LEGAL_REP_OF`(
  `extra_json` string NULL,
  `organization_id` string NULL,
  `confidence` double NULL,
  `source_table` string NULL,
  `source_record_id` string NULL,
  `ingest_batch` string NULL,
  `ingest_time` string NULL
);

CREATE EDGE IF NOT EXISTS `EXECUTIVE_OF`(
  `position` string NULL,
  `extra_json` string NULL,
