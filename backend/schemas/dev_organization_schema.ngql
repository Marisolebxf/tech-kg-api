);

CREATE TAG INDEX IF NOT EXISTS `organization_org_id_idx` ON `Organization`(`org_id`(128));
CREATE TAG INDEX IF NOT EXISTS `organization_id_idx` ON `Organization`(`organization_id`(128));
CREATE TAG INDEX IF NOT EXISTS `organization_base_id_idx` ON `organization_base`(`organization_id`(128));
CREATE TAG INDEX IF NOT EXISTS `organization_name_cn_idx` ON `Organization`(`name_cn`(128));
CREATE TAG INDEX IF NOT EXISTS `datasource_table_idx` ON `DataSource`(`source_table`(128));
CREATE EDGE INDEX IF NOT EXISTS `shareholder_of_idx` ON `SHAREHOLDER_OF`();
CREATE EDGE INDEX IF NOT EXISTS `legal_rep_of_idx` ON `LEGAL_REP_OF`();
CREATE EDGE INDEX IF NOT EXISTS `executive_of_idx` ON `EXECUTIVE_OF`();
CREATE EDGE INDEX IF NOT EXISTS `beneficial_owner_of_idx` ON `BENEFICIAL_OWNER_OF`();
CREATE EDGE INDEX IF NOT EXISTS `actual_controller_of_idx` ON `ACTUAL_CONTROLLER_OF`();
CREATE EDGE INDEX IF NOT EXISTS `invests_in_idx` ON `INVESTS_IN`();
CREATE EDGE INDEX IF NOT EXISTS `acquires_idx` ON `ACQUIRES`();
CREATE EDGE INDEX IF NOT EXISTS `subsidiary_of_idx` ON `SUBSIDIARY_OF`();
CREATE EDGE INDEX IF NOT EXISTS `participates_in_idx` ON `PARTICIPATES_IN`();
CREATE EDGE INDEX IF NOT EXISTS `funded_by_idx` ON `FUNDED_BY`();
CREATE EDGE INDEX IF NOT EXISTS `has_news_idx` ON `HAS_NEWS`();
CREATE EDGE INDEX IF NOT EXISTS `involved_in_idx` ON `INVOLVED_IN`();
CREATE EDGE INDEX IF NOT EXISTS `belongs_to_node_idx` ON `BELONGS_TO_NODE`();
CREATE EDGE INDEX IF NOT EXISTS `produces_idx` ON `PRODUCES`();
