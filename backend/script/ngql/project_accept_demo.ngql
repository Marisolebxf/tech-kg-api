-- 周四评审演示：TRSGraph Studio → space=dev
USE dev;

FETCH PROP ON Project "project_fake-zh-proj-001" YIELD properties(vertex);

GO FROM "project_fake-zh-proj-001" OVER LEADS, FUNDED_BY
YIELD edge as e, dst(edge) as dst;

GO FROM "project_fake-zh-proj-001" OVER HAS_KEYWORD
YIELD dst(edge) as keyword;

GO FROM "project_fake-zh-proj-001" OVER OUTPUT_OF REVERSELY
YIELD src(edge) as output;

GO FROM "project_fake-zh-proj-001" OVER HAS_PARTICIPANT, PARTICIPATES_IN REVERSELY
YIELD dst(edge) as related;
