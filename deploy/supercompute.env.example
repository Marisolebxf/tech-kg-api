# 复制成未跟踪的 deploy/supercompute.env，填写后由同事注入部署。
# 本文件是模板，不包含真实凭据。临时 IP 只出现在部署配置中。
# Compose 直接拼接以下两项，两者末尾均不要添加 /。
PUBLIC_BASE_URL=http://183.62.232.63
APP_BASE=/bkg_zp

# 此地址只打开门户；登录后自动回到原子页面的协议仍待门户方确认。
USER_CENTER_PORTAL_LOGIN_URL=/portal/
AUTH_LOGIN_MODE=portal
AUTH_ENABLED=true
USER_CENTER_PORTAL_COOKIE_LOGIN_ENABLED=true
# 沿用现有部署约定。联调时确认门户实际下发的名称及 Path 能覆盖 /bkg_zp/api/。
USER_CENTER_PORTAL_TOKEN_COOKIE=access_token

# 从“亿级科技知识图谱引擎-超算环境”读取，密钥仅提供给后端。
USER_CENTER_CLIENT_ID=
USER_CENTER_CLIENT_SECRET=

# 临时入口为 HTTP；换为 HTTPS 时同步改成 true。
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_SESSION_BACKEND=redis
PLATFORM_BOOTSTRAP_FIRST_ADMIN=false

# 若后端需通过内网连接 UC，可分别覆盖；浏览器仍使用 PUBLIC_BASE_URL。
# USER_CENTER_OAUTH_BASE_URL=http://<内部UC入口>/uc/admin-api/system/oauth2
# USER_CENTER_OPEN_API_BASE_URL=http://<内部UC入口>/uc/open-api/system

# 前端容器使用以下运行时配置；后端不使用这些变量。
APP_API_BASE=/bkg_zp/api
PORTAL_ALLOWED_ORIGINS=/
PORTAL_TARGET_ORIGIN=/
PORTAL_EMBEDDED_DEFAULT=false
ADMIN_EXAMPLE_FALLBACK=false
