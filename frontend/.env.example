# 本地 dev / 显式构建期配置。生产镜像走运行时注入（方案 B）：
#   前端镜像以哨兵 /__BASE__/ 构建，部署期由 docker/40-app-runtime-config.sh
#   按 APP_BASE / TRS_GRAPH_SPACE / AUTH_ENABLED / PORTAL_* 等环境变量注入
#   （见 docs/前端一次构建多环境部署方案.md），不再需要在构建时传 VITE_*。
VITE_API_TARGET=http://localhost:8000
VITE_API_BASE=/api
VITE_GRAPH_SPACE=test
VITE_BASE=./
VITE_AUTH_ENABLED=false
VITE_ADMIN_EXAMPLE_FALLBACK=true
VITE_PORTAL_EMBEDDED_DEFAULT=false
VITE_PORTAL_ALLOWED_ORIGINS=https://edu.itic-sci.com
VITE_PORTAL_TARGET_ORIGIN=https://edu.itic-sci.com
VITE_PORTAL_SOURCE=tech-kg-api
